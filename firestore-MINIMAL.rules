rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---- GROUP TRIP CHAT ----
    match /tripchats/{roomId} {
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.members);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members;
      allow update: if signedIn()
        && request.auth.uid in request.resource.data.members;
      match /msgs/{msgId} {
        allow read: if signedIn()
          && exists(/databases/$(database)/documents/tripchats/$(roomId))
          && request.auth.uid in get(/databases/$(database)/documents/tripchats/$(roomId)).data.members;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if isAdmin();
      }
    }

    // ---- T-SHIRT / MERCH ORDERS ----
    match /merch/{id} {
      allow create: if signedIn()
        && request.resource.data.status == 'new'
        && request.resource.data.slogan is string
        && request.resource.data.slogan.size() <= 120;
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ---- STAFF ROLES ----
    match /staff/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.role == 'none');
      allow update, delete: if isAdmin();
    }

    // ---- USER PROFILES ----
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // ---- everything else: signed-in read, admin write (safe default) ----
    // ---- INVESTOR DECK LEADS (public create, admin read only) ----
    // Anyone opening the private deck link can create/update THEIR lead doc
    // (name, role, contact, scroll depth, time). Only admins can read them.
    match /deckleads/{id} {
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 160;
      // tracking updates (scroll depth, time) don't resend name - allow any
      // update to an existing lead so engagement data actually records.
      allow update: if resource != null;
      allow read, delete: if isAdmin();
    }

    // ---- HR DOCUMENTS (offer letters, salary slips, etc.) admin only ----
    match /hrdocs/{id} {
      allow read, write: if isAdmin();
    }

    // ---- ADMINS (owner allow-list) ----
    // Read your own doc. You may set ONLY your own pinHash (second-factor);
    // you can never grant yourself admin status - that is Console-only.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinHash']);
    }

    match /{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
