{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["app.js", "js/**/*.js", "js/global.d.ts"],
  "exclude": ["node_modules", "worker/**", "vendor/**", "**/*.min.js"]
}
