# Build days from canonical stops while keeping contiguous route progression.
def build_days(dest, n):
    stops=dest['stops']
    m=len(stops)
    if n <= m:
        groups=[]
        for i in range(n):
            a=round(i*m/n); b=round((i+1)*m/n)
            if b<=a: b=a+1
            groups.append(stops[a:min(b,m)])
    else:
        groups=[[s] for s in stops]
        while len(groups)<n:
